# Copy to `.env.localwp` (gitignored) for local WordPress E2E acceptance testing.
FORGEWP_LOCALWP_URL=http://forgewp-test.local
FORGEWP_LOCALWP_ADMIN_URL=http://forgewp-test.local/wp-admin
FORGEWP_LOCALWP_USERNAME=your-local-wp-username
FORGEWP_LOCALWP_PASSWORD=your-local-wp-password
FORGEWP_LOCALWP_SITE_PATH=C:\Users\<user>\Local Sites\forgewp-test
FORGEWP_LOCALWP_THEMES_PATH=C:\Users\<user>\Local Sites\forgewp-test\app\public\wp-content\themes
