# ForgeWP Next.js Deployment Configuration
# Leave unset (or 'native') for static WordPress theme export via `pnpm export`.
# Set to 'decoupled' to run Next.js as a live server backed by WordPress REST.
FORGEWP_DEPLOYMENT_MODE=native

# Live WordPress URL for decoupled mode (e.g. https://cms.example.com)
# FORGEWP_WP_URL=

# Optional WordPress Application Password ("username:xxxx xxxx xxxx") for draft previews (server-only)
# FORGEWP_WP_AUTH=

# Optional shared preview secret for gated draft routes (server-only)
# FORGEWP_DRAFT_SECRET=
