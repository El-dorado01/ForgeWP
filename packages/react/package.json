{
  "name": "@forgewp/react",
  "version": "0.4.3",
  "description": "Lightweight WordPress data hooks and primitives for React — ForgeWP",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "require": "./src/config.ts",
      "default": "./src/config.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "lucide-react": "^0.475.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "wordpress",
    "react",
    "forgewp",
    "headless",
    "hooks"
  ],
  "license": "MIT",
  "dependencies": {
    "@wordpress/block-serialization-default-parser": "^5.57.0",
    "html-react-parser": "^5.2.10"
  }
}
