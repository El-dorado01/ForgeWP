"<?php
/**
 * Gutenberg dynamic block template — Contact Form
 * Autogenerated by ForgeWP Theme Compiler. Do not modify manually.
 */
$loading = true;
$isLoading = true;
$hotels = array();
$posts = array();
$listicles = array();
$destinations = array();
$titleMeta = forgewp_get_meta_value('form_title', 'Kontaktformular', false, null);
$descMeta = forgewp_get_meta_value('form_description', 'Alle Felder sind Pflichtfelder, sofern nicht anders angegeben.', false, null);
$formTitle = ($titleProp ?? null) ?? ($titleMeta ?? null);
$formDescription = ($descProp ?? null) ?? ($descMeta ?? null);
?>
<div class="w-full min-w-0 <?php echo esc_attr( forgewp_padding_classes($attributes ?? array()) ); ?>">
      <?php if (($setAttributes ?? null)): ?>
<div class="mb-6 p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
