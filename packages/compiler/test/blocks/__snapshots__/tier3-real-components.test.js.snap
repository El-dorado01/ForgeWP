          <p class="text-[10px] text-slate-400 pt-2 border-t border-slate-200/60">
            Form fields (subject, message) are managed under Appearance → Forms.
          </p>
        </div>
<?php else: ?>
<div class="forgewp-hydrate-boundary" data-forgewp-hydrate="contact-form" data-forgewp-props="<?php echo esc_attr( json_encode( array('formTitle' => ($attributes['formTitle'] ?? null), 'formDescription' => ($attributes['formDescription'] ?? null)) ) ); ?>" data-forgewp-trigger="visible" style="display: <?php echo esc_attr( 'block' ); ?>;"></div>
<?php endif; ?>
