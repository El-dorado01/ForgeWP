          <div class="space-y-1">
            <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500">Form Title:</div>
            <div class="text-sm text-slate-800 font-bold"><?php echo esc_html( $formTitle ?? '' ); ?></div>
          </div>
          <div class="space-y-1">
            <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500">Form Description:</div>
            <div class="text-xs text-slate-600"><?php echo esc_html( $formDescription ?? '' ); ?></div>
