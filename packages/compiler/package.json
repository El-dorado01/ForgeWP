{
  "name": "@forgewp/compiler",
  "version": "0.4.3",
  "description": "Compile ForgeWP React themes into installable WordPress themes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forgewp": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./define-config": {
      "types": "./define-config.d.ts",
      "default": "./define-config.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "define-config.js",
    "define-config.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@forgewp/ui": "workspace:*",
    "archiver": "^7.0.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "react-helmet-async": "^3.0.0",
    "select2": "^4.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "test:export-fixture": "node test/export-fixture/run-export-fixture.js",
    "test:auth-transpilation": "node test/auth-transpilation.js",
    "test:adapter-runtime": "node test/adapter-loader.js",
    "test:adapter-types": "pnpm exec tsc --noEmit -p tsconfig.test.json"
  }
}
