{
  "name": "@forgewp/compiler",
  "version": "0.1.8",
  "description": "Compile ForgeWP React themes into installable WordPress themes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forgewp": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@forgewp/ui": "workspace:*",
    "archiver": "^7.0.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  }
}
