{
  "name": "@forgewp/compiler",
  "version": "0.4.0",
  "description": "Compile ForgeWP React themes into installable WordPress themes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forgewp": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@forgewp/ui": "workspace:*",
    "archiver": "^7.0.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  },
  "scripts": {
    "test:export-fixture": "node test/export-fixture/run-export-fixture.js",
    "test:adapter-runtime": "node test/adapter-loader.js",
    "test:adapter-types": "pnpm exec tsc --noEmit -p tsconfig.test.json"
  }
}
