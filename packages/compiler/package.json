{
  "name": "@forgewp/compiler",
  "version": "0.1.5",
  "description": "Compile ForgeWP React themes into installable WordPress themes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forgewp-export": "./bin/export.js",
    "forgewp-add": "./bin/add.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@forgewp/registry": "workspace:*",
    "archiver": "^7.0.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  }
}
