{
  "name": "@forgewp/woocommerce",
  "version": "0.2.0",
  "description": "WooCommerce components and hooks for ForgeWP themes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El-dorado01/ForgeWP.git",
    "directory": "packages/woocommerce"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "require": "./src/server.ts",
      "default": "./src/server.ts",
      "types": "./src/server.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "@forgewp/react": "*",
    "lucide-react": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@forgewp/react": "workspace:*",
    "lucide-react": "^0.475.0",
    "typescript": "^5.8.3",
    "react": "^19.0.0"
  },
  "license": "MIT"
}
